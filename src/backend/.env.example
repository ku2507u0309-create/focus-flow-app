# Environment variables for Personal Productivity Assistant Backend

# Secret key for JWT tokens (change in production!)
SECRET_KEY=your-secret-key-change-in-production

# Admin token for initial setup (change in production!)
CAFFEINE_ADMIN_TOKEN=admin-secret-token-change-in-production

# Database URL (SQLite for development, PostgreSQL for production)
# SQLite (default):
DATABASE_URL=sqlite:///./test.db

# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost/productivity_app

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
